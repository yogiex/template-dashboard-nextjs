# Contoh environment variable untuk template ini.
# Salin ke .env.local untuk pengembangan lokal: cp .env.example .env.local
# Jangan pernah menaruh nilai secret nyata di file ini; file ini ikut ter-commit.
#
# Format: dua baris per variabel.
#   1. komentar: kegunaan + apakah wajib di production.
#   2. kunci=value (nilai di bawah ini aman / dummy, bukan secret sungguhan).

# --- Client (dikirim ke browser, HARUS PUBLIK) ---

# URL publik aplikasi; dipakai untuk metadata, sitemap, robots, dan link absolut.
# Wajib diisi di production sebagai domain asli (tanpa trailing slash).
# Docker/nginx secara lokal memakai http://localhost:9080 (port proxy nginx).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server (TIDAK boleh memakai prefix NEXT_PUBLIC_) ---

# Next.js sudah mengisinya sendiri; default "development" dipakai kalau kosong.
NODE_ENV=development

# Level log pino: debug | info | warn | error. Opsional, default "info".
# Naikkan ke "debug" hanya untuk investigasi lokal, jangan di production.
LOG_LEVEL=info

# Kunci enkripsi Server Action (minimal 32 karakter, stabil antar-instance).
# Opsional agar template jalan tanpa konfigurasi, tetapi WAJIB di production
# yang menjalankan lebih dari satu instance, karena ID terenkripsi harus sama
# di semua instance. Hasilkan dengan: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=ganti-dengan-32-karakter-acak-minimal

# Flag opsional untuk mengaktifkan /api/health/metrics (Prometheus text format).
# Default "false" berarti endpoint tersebut mengembalikan 404, karena metadata
# proses tidak perlu terekspos pada template yang belum punya backend.
# Nilainya hanya dibaca sebagai flag true/false; tidak pernah ditampilkan.
HEALTH_METRICS_ENABLED=false

# --- Backend belum ada: bypass autentikasi lokal (JANGAN di environment ter-deploy) ---
# PERINGATAN: flag ini mematikan pemeriksaan sesi. Satu-satunya konsumennya
# requireSessionForDev() di src/lib/rbac.ts, yang mengembalikan sesi placeholder
# (id usr_placeholder, role admin) tanpa login sama sekali, sehingga setiap action
# yang memakai helper itu bisa dipanggil tanpa autentikasi. Hanya untuk
# pengembangan di mesin lokal; jangan pernah ada di .env / .env.production.
# Dua syarat harus lolos: nilainya persis "1" DAN NODE_ENV bukan "production".
# Jadi di production flag ini tetap tidak berguna, tapi jangan andalkan itu —
# hapus saja dari deployment. Nilai yang diterima hanya "0" (mati) dan "1" (aktif,
# lokal saja); "true" atau "yes" menggagalkan boot.
# Biarkan ter-comment di sini sebagai pengingat, jangan diaktifkan.
# DEV_AUTH_BYPASS=1

# --- Container (hanya untuk docker compose, bukan dibaca kode aplikasi) ---
# docker-compose.yml sudah memaksa NODE_ENV=production; docker-compose juga
# membaca APP_VERSION untuk tag image. Nilai di bawah hanya contoh default.
# APP_VERSION=local
# PORT=3000        # port internal Next.js (expose, bukan publish)
# HOSTNAME=0.0.0.0 # bind address internal container
